# Copy this file to .env before running the server:  cp .env.example .env
# (On cPanel/shared hosting, set these as Environment Variables in the
# "Setup Node.js App" screen instead — no .env file needed there.)

PORT=3000

# ── MySQL ──────────────────────────────────────────────────────────
# Create the database + a DB user in cPanel's "MySQL® Databases" tool
# first, then fill these in with the exact values it gives you
# (cPanel usually prefixes both the DB name and DB user with your
# cPanel username, e.g. myuser_a2erp / myuser_a2user).
DB_HOST=localhost
DB_PORT=3306
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=change_me

# ── Login sessions (JWT) ──────────────────────────────────────────
# Long random string used to sign login tokens. A safe one is already
# generated for you below, or make your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=b8a5aaa426111baa60a66ec5c683dbada9ab45152ff0a96c27506947421397efb75d265d8f2ecd0cb13f015b9720fb03
JWT_EXPIRES_IN=12h

# ── Push notifications (Web Push / VAPID) ─────────────────────────
# Generated for you already — you can use these, or run
# `node generate-vapid-keys.js` to make your own fresh pair.
VAPID_PUBLIC_KEY=BNPPs3mjlhLERkeWCfvzsagVJ2dX7kkPq6HYtn7_06uyfPv5VfOfHcesJuNouKjDISq0nwGKctOzjWydY92SPNU
VAPID_PRIVATE_KEY=qE_NQ_NIL4FFWPYl9xsU6Y_BTkLKj8zUXHgTuMSbhUs
VAPID_SUBJECT=mailto:you@yourdomain.com
